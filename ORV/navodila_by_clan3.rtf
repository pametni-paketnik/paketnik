\f1\b\fs36 \cf0 \strokec2 2. MOBILNA APLIKACIJA: Android Studio (Kotlin)\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Mobilna aplikacija mora odpreti kamero, shraniti sliko v pomnilnik in jo preko knji\'9enice 
\f1\b Retrofit
\f2\b0  ali 
\f1\b OkHttp
\f2\b0  poslati direktno na tvoj FastAPI (ali pa preko Expressa).\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \uc0\u9888 \u65039  
\f1\b Pomembno za Android:
\f2\b0  \uc0\u268 e testira\'9a na emulatorju, tvoj ra\u269 unalnik ni 
\f4\fs26 localhost
\f2\fs24 , ampak ima v emulatorju poseben IP naslov: 
\f3\b\fs26 http://10.0.2.2:8000
\f2\b0\fs24  (to ka\'9ee na localhost tvojega ra\uc0\u269 unalnika, kjer te\u269 e FastAPI).\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 A) Definicija Retrofit vmesnika v Kotlinu\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Najprej ustvari vmesnik (Interface), ki pove, kako izgleda HTTP klic na FastAPI endpoint 
\f4\fs26 /verify
\f2\fs24 .\
\pard\pardeftab720\partightenfactor0
\cf0 Kotlin\
\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 import okhttp3.MultipartBody\
import okhttp3.ResponseBody\
import retrofit2.Call\
import retrofit2.http.Multipart\
import retrofit2.http.POST\
import retrofit2.http.Part\
\
interface FaceApiService \{\
    @Multipart\
    @POST("verify") // tvoj endpoint na FastAPI\
    fun preveriObraz(\
        @Part slika: MultipartBody.Part\
    ): Call<ResponseBody> // Lahko ustvari\'9a tudi podatkovni razred (data class) namesto ResponseBody\
\}\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 B) Logika za po\'9ailjanje slike iz naprave\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Ko uporabnik v Android aplikaciji klikne "Slikaj in preveri", dobi\'9a datoteko (
\f4\fs26 File
\f2\fs24 ). To datoteko pretvori\'9a v 
\f4\fs26 MultipartBody.Part
\f2\fs24 in jo po\'9alje\'9a.\
\pard\pardeftab720\partightenfactor0
\cf0 Kotlin\
\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 import android.os.Bundle\
import android.util.Log\
import android.widget.Button\
import android.widget.Toast\
import androidx.appcompat.app.AppCompatActivity\
import okhttp3.MediaType.Companion.toMediaTypeOrNull\
import okhttp3.MultipartBody\
import okhttp3.RequestBody.Companion.asRequestBody\
import okhttp3.ResponseBody\
import retrofit2.Call\
import retrofit2.Callback\
import retrofit2.Response\
import retrofit2.Retrofit\
import retrofit2.converter.gson.GsonConverterFactory\
import java.io.File\
\
class MainActivity : AppCompatActivity() \{\
\
    override fun onCreate(savedInstanceState: Bundle?) \{\
        super.onCreate(savedInstanceState)\
        setContentView(R.layout.activity_main)\
\
        val gumbPreveri = findViewById<Button>(R.id.btn_preveri)\
        \
        gumbPreveri.setOnClickListener \{\
            // Predpostavimo, da ima\'9a pot do shranjene slike iz kamere\
            val slikaFajl = File(filesDir, "zajet_obraz.jpg") \
            \
            if (slikaFajl.exists()) \{\
                posljiSlikoNaServer(slikaFajl)\
            \} else \{\
                Toast.makeText(this, "Slika ne obstaja. Najprej se slikaj!", Toast.LENGTH_SHORT).show()\
            \}\
        \}\
    \}\
\
    private fun posljiSlikoNaServer(file: File) \{\
        // 1. Nastavi Retrofit (10.0.2.2 je localhost za Android emulator)\
        val retrofit = Retrofit.Builder()\
            .baseUrl("http://10.0.2.2:8000/") \
            .addConverterFactory(GsonConverterFactory.create())\
            .build()\
\
        val apiService = retrofit.create(FaceApiService::class.java)\
\
        // 2. Pripravi datoteko za Multipart po\'9ailjanje\
        val requestFile = file.asRequestBody("image/jpeg".toMediaTypeOrNull())\
        val body = MultipartBody.Part.createFormData("file", file.name, requestFile)\
\
        // 3. Izvedi asinhroni klic\
        apiService.preveriObraz(body).enqueue(object : Callback<ResponseBody> \{\
            override fun onResponse(call: Call<ResponseBody>, response: Response<ResponseBody>) \{\
                if (response.isSuccessful) \{\
                    val odgovorStreznik = response.body()?.string()\
                    Log.d("API_USPEH", "Odgovor: $odgovorStreznik")\
                    \
                    // Tukaj v odgovoru preveri\'9a \uc0\u269 e je "verified": true\
                    Toast.makeText(this@MainActivity, "Uspe\'9ano preverjeno!", Toast.LENGTH_LONG).show()\
                \} else \{\
                    Toast.makeText(this@MainActivity, "Obraz ni prepoznan.", Toast.LENGTH_LONG).show()\
                \}\
            \}\
\
            override fun onFailure(call: Call<ResponseBody>, t: Throwable) \{\
                Log.e("API_NAPAKA", t.message ?: "Neznana napaka")\
                Toast.makeText(this@MainActivity, "Povezava s stre\'9enikom ni uspela.", Toast.LENGTH_SHORT).show()\
            \}\
        \})\
    \}\
\}\
