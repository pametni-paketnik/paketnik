\f1\b\fs36 \cf0 \strokec2 1. SPLETNA STRAN: React (Front-end) & Express (Back-end)\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Najbolj\'9aa praksa za spletne aplikacije je, da React komunicira s tvojim Express stre\'9enikom, Express pa v ozadju pokli\uc0\u269 e FastAPI.\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 A) Express Node.js Back-end (
\f3\fs30\fsmilli15210 \strokec2 server.js
\f1\fs28 \strokec2 )\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Express mora sprejeti zahtevo za prijavo in po\uc0\u269 akati na potrditev, ali pa preprosto posredovati sliko na FastAPI. Tukaj je primer, kako v Expressu sprejme\'9a sliko in jo po\'9alje\'9a na FastAPI (
\f4\fs26 http://localhost:8000/verify
\f2\fs24 ).\
Za delo s slikami v Expressu bo\'9a potrebovala knji\'9enici 
\f4\fs26 multer
\f2\fs24  in 
\f4\fs26 axios
\f2\fs24  (
\f4\fs26 npm install multer axios form-data
\f2\fs24 ).\
\pard\pardeftab720\partightenfactor0
\cf0 JavaScript\
\

\f4\fs26 const express = require('express');\
const multer = require('multer');\
const axios = require('axios');\
const FormData = require('form-data');\
const cors = require('cors');\
\
const app = express();\
app.use(cors());\
app.use(express.json());\
\
// Nastavitev pomnilnika za za\uc0\u269 asni sprejem slik\
const upload = multer(\{ storage: multer.memoryStorage() \});\
\
// Endpoint, ki ga pokli\uc0\u269 e React ali Android\
app.post('/api/spletna-prijava', upload.single('slika'), async (req, res) => \{\
    try \{\
        if (!req.file) \{\
            return res.status(400).json(\{ error: 'Slika ni prilo\'9eena.' \});\
        \}\
\
        // Pripravimo podatke za FastAPI (multipart/form-data)\
        const form = new FormData();\
        form.append('file', req.file.buffer, \{\
            filename: req.file.originalname,\
            contentType: req.file.mimetype,\
        \});\
\
        // Po\'9aljemo sliko na tvoj FastAPI Docker vsebnik\
        const fastapiResponse = await axios.post('http://localhost:8000/verify', form, \{\
            headers: form.getHeaders()\
        \});\
\
        // FastAPI vrne: \{ verified: true/false, label: "manja", confidence: 0.92 \}\
        const rezultat = fastapiResponse.data;\
\
        if (rezultat.verified) \{\
            return res.json(\{\
                uspeh: true,\
                sporocilo: `Dobrodo\'9ali, $\{rezultat.label\}!`,\
                uporabnik: rezultat.label\
            \});\
        \} else \{\
            return res.status(401).json(\{\
                uspeh: false,\
                sporocilo: 'Avtentikacija neuspe\'9ana. Obraz ni prepoznan.'\
            \});\
        \}\
\
    \} catch (error) \{\
        console.error("Napaka na API-ju:", error.message);\
        res.status(500).json(\{ error: 'Napaka pri komunikaciji z AI modelom.' \});\
    \}\
\});\
\
app.listen(5000, () => console.log('Express stre\'9enik te\uc0\u269 e na portu 5000'));\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 B) React Front-end (Komponenta za prijavo)\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 V Reactu bo\'9a uporabila spletno kamero (lahko uporabi\'9a knji\'9enico 
\f4\fs26 react-webcam
\f2\fs24 ) ali pa preprost gumb za nalaganje datoteke, ki po\'9alje sliko na Express.\
\pard\pardeftab720\partightenfactor0
\cf0 JavaScript\
\

\f4\fs26 import React, \{ useState \} from 'react';\
\
function Prijava() \{\
    const [slika, setSlika] = useState(null);\
    const [status, setStatus] = useState('');\
\
    const handleFileChange = (e) => \{\
        setSlika(e.target.files);\
    \};\
\
    const handlePrijava = async () => \{\
        if (!slika) \{\
            setStatus('Prosim, izberi ali zajemi sliko obraza.');\
            return;\
        \}\
\
        const formData = new FormData();\
        formData.append('slika', slika);\
\
        setStatus('Preverjam obraz...');\
\
        try \{\
            const povratnaInformacija = await fetch('http://localhost:5000/api/spletna-prijava', \{\
                method: 'POST',\
                body: formData,\
            \});\
\
            const podatki = await povratnaInformacija.json();\
            \
            if (podatki.uspeh) \{\
                setStatus(`\uc0\u10003  Uspe\'9ana prijava! \'8eivijo $\{podatki.uporabnik\}`);\
                // Tukaj jo preusmeri\'9a naprej v aplikacijo (npr. z react-router)\
            \} else \{\
                setStatus(`\uc0\u10007  Zavrnjeno: $\{podatki.sporocilo\}`);\
            \}\
        \} catch (err) \{\
            setStatus('Napaka pri povezavi s stre\'9enikom.');\
        \}\
    \};\
\
    return (\
        <div style=\{\{ padding: '20px', textAlign: 'center' \}\}>\
            <h2>2FA Prepoznava Obraza</h2>\
            <input type="file" accept="image/*" onChange=\{handleFileChange\} />\
            <br /><br />\
            <button onClick=\{handlePrijava\}>Preveri identiteto</button>\
            <p><strong>Status:</strong> \{status\}</p>\
        </div>\
    );\
\}\
\
export default Prijava;\
